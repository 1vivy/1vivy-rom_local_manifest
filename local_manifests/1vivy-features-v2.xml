  <!-- The qtidisplay soong config namespace is GLOBAL, but each caf display tree
       declares its own allowed value set for composer_version. Only two declare it:
       sm8850 (ours) accepts v3_2/v3_3/v3_4, sm8750 accepts v2/v3/v3_3/qmaa. Their
       only common value is v3_3, which is why the platform default is v3_3 - and
       v3_3 is the one value our forked sm8850 stack cannot build at, because the
       rest of it is on the V4/V13 generation. sm8750 is pakala, a platform this
       lane never builds, so drop it rather than pin the whole tree to the
       intersection. Path-scoped: the same project name is checked out at several
       other platform paths, which stay. -->
  <remove-project name="LineageOS/android_hardware_qcom_display"
                  path="hardware/qcom-caf/sm8750/display/hal" optional="true" />
  <!-- The sm8750 display stack is three interdependent projects: hal defines the
       qtidisplay_*_defaults that core and intf build against, so removing hal alone
       orphans them ("libdisplaydebug depends on undefined module
       qtidisplay_common_defaults"). Remove the trio as the unit it is. -->
  <remove-project name="LineageOS/android_vendor_qcom_opensource_display-core"
                  path="hardware/qcom-caf/sm8750/display/core" optional="true" />
  <remove-project name="LineageOS/android_vendor_qcom_opensource_display-intf"
